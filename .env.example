# Copy this file to .env.local and fill in the values.

# Your live domain, without a trailing slash. Used for canonical URLs, hreflang tags and the sitemap.
# On Vercel you can leave this empty: the production domain is detected automatically.
# Set it once you have your own domain, e.g. https://www.toolnook.com
NEXT_PUBLIC_SITE_URL=

# Your AdSense publisher ID (ca-pub-...). Leave empty until AdSense gives you one.
# When set, the AdSense script is added to every page (works with Auto ads).
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: an ad unit slot ID for the in-content ad blocks. Leave empty to rely on Auto ads.
NEXT_PUBLIC_ADSENSE_SLOT=
